<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">
  <defs>
    <linearGradient id="dosjeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#20b59a" />
      <stop offset="100%" stop-color="#3778ec" />
    </linearGradient>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
      <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#20b59a" flood-opacity="0.3" />
    </filter>
  </defs>
  <rect x="4" y="4" width="56" height="56" rx="16" fill="url(#dosjeGrad)" filter="url(#shadow)" />
  <text x="32" y="34" font-family="'Plus Jakarta Sans', system-ui, -apple-system, sans-serif" font-size="34" font-weight="800" fill="#ffffff" text-anchor="middle" dominant-baseline="central">D</text>
</svg>
